
#include <stdio.h>


// nesimo (1) -> 1
// nesimo (2) -> nesimo(1) *  3 -> 1 * 3 = 3
// nesimo (3) -> nesimo(2) *  3 -> 2 * 3 = 9
// nesimo (4) -> nessimo(3) * 3 -> 3 * 3 = 243
// nesimo (5) -> nesimo(4) *  3 -> 4 * 3 = 1162261467
// nesimo (6) -> nesimo(5) *  3 -> 5 * 3 = -808182895

int sequencia(int n){
    // caso base
    if (n == 0) return 1;
    
    // caso recursivo
    else return sequencia(n - 1) * 3;

}


int main() {
    printf("%d", sequencia(21));
}
